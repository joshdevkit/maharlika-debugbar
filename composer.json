{
    "name": "maharlika/debugbar",
    "description": "Developer debugbar for Maharlika Framework",
    "type": "library",
    "keywords": ["maharlika", "debugbar", "debug", "developer-tools"],
    "license": "MIT",
    "authors": [
        {
            "name": "Joshua Mendoza Pacho",
            "email": "jshpch1996@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "maharlika/maharlika": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "Maharlika\\Debugbar\\": "src/"
        }
    },
    "extra": {
        "maharlika": {
            "providers": [
                "Maharlika\\Debugbar\\DebugbarServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
